// CANLI SİTE (Render) AYARLARI: appsettings.json'daki değerlerin üzerine yazılır.
// Render "ASPNETCORE_ENVIRONMENT=Production" ile çalışır; bilgisayardaki BASLAT.bat "Development" kullanır,
// yani bu dosya sadece canlı sitede geçerlidir.
{
  "VeriTabani": {
    // Canlı sitede her şey Neon'da: üyeler, rezervasyonlar ve admin panelden yapılan değişiklikler kalıcıdır.
    // Neon'daki tablolar boşsa açılışta örnek veriler bir kez yüklenir. Neon adresi (Render → Environment →
    // ConnectionStrings__PostgreSql) boşsa site geçici SQLite ile açılır.
    "SayfalarNeredenOkusun": "Neon"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
