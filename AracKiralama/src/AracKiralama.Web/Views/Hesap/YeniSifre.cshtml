@* GEÇİCİ ŞİFREYLE İLK GİRİŞ: kişi kendi şifresini belirlemeden siteyi kullanamaz (Yardimcilar/SifreKontrolu.cs). *@
@model YeniSifreFormu
@{ ViewData["Title"] = Icerik.Metin("hesap.yeni-sifre-baslik"); }
<div class="giris-sayfasi">
    <div class="giris-yan">
        <h2 data-giris style="--i:1">@Icerik.Metin("hesap.yeni-sifre-baslik")</h2>
        <p class="opacity-75 mb-0" data-giris style="--i:2">Bu adım bir kez yapılır.</p>
    </div>
    <div class="giris-form">
        <div class="ic" data-giris style="--i:0">
            <h1 class="h3">@Icerik.Metin("hesap.yeni-sifre-baslik")</h1>
            <p class="text-muted">@Icerik.Metin("hesap.yeni-sifre-metin")</p>
            <form asp-action="YeniSifre" method="post" data-yukleniyor="Kaydediliyor…">
                <partial name="_YeniSifreKutusu" model="@("Sifre")" />
                <button class="btn btn-primary btn-lg w-100 mt-3">Şifremi kaydet ve devam et <i class="bi bi-arrow-right ms-1"></i></button>
            </form>
            <form asp-action="Cikis" method="post" class="text-center mt-3"><button class="btn btn-link btn-sm text-muted">Çıkış yap</button></form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_FormDogrulama" /> }
