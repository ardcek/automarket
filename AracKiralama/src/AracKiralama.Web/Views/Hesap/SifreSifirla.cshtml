@* E-POSTADAKİ LİNKTEN AÇILAN SAYFA: yeni şifre belirlenir (HesapController → SifreSifirla). *@
@model SifreSifirlaFormu
@{ ViewData["Title"] = Icerik.Metin("hesap.sifirla-baslik"); }
<div class="giris-sayfasi">
    <div class="giris-yan">
        <h2 data-giris style="--i:1">@Icerik.Metin("hesap.sifirla-baslik")</h2>
        <p class="opacity-75 mb-0" data-giris style="--i:2">Yeni şifreniz kaydedilince hemen giriş yapabilirsiniz.</p>
    </div>
    <div class="giris-form">
        <div class="ic" data-giris style="--i:0">
            <h1 class="h3">@Icerik.Metin("hesap.sifirla-baslik")</h1>
            <p class="text-muted">Hesap: <b>@Model.Eposta</b></p>
            <form asp-action="SifreSifirla" method="post" data-yukleniyor="Kaydediliyor…">
                <input type="hidden" asp-for="Eposta" />
                <input type="hidden" asp-for="Kod" />
                <partial name="_YeniSifreKutusu" model="@("Sifre")" />
                <button class="btn btn-primary btn-lg w-100 mt-3">Şifremi kaydet <i class="bi bi-check2 ms-1"></i></button>
            </form>
        </div>
    </div>
</div>
@section Scripts { <partial name="_FormDogrulama" /> }
