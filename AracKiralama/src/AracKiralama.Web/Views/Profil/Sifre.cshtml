@* HESABIM → ŞİFREMİ DEĞİŞTİR (ProfilController → Sifre). Şu anki şifre doğru girilirse yeni şifre kaydedilir. *@
@model SifreDegistirFormu
@{ ViewData["Title"] = "Şifremi değiştir"; }
<div class="container py-4" style="max-width: 560px">
    <a href="/Profil" class="small"><i class="bi bi-arrow-left me-1"></i>Hesabım</a>
    <h1 class="h3 mt-2 mb-4">Şifremi değiştir</h1>
    <form asp-action="Sifre" method="post" class="card" data-yukleniyor="Kaydediliyor…">
        <div class="card-body d-grid gap-3">
            <div>
                <label asp-for="MevcutSifre" class="form-label"></label>
                <div class="sifre-kutusu">
                    <input asp-for="MevcutSifre" class="form-control" autocomplete="current-password" />
                    <button type="button" class="sifre-goster" data-sifre-goster aria-label="Şifreyi göster" aria-pressed="false"><i class="bi bi-eye"></i></button>
                </div>
                <span asp-validation-for="MevcutSifre"></span>
            </div>
            <div><partial name="_YeniSifreKutusu" model="@("YeniSifre")" /></div>
            <div class="small text-muted"><i class="bi bi-info-circle me-1"></i>Şu anki şifrenizi hatırlamıyorsanız çıkış yapıp giriş sayfasındaki <b>Şifremi unuttum</b> bağlantısını kullanın.</div>
        </div>
        <div class="card-body border-top text-end"><a href="/Profil" class="btn btn-sade">Vazgeç</a> <button class="btn btn-primary">Şifremi değiştir</button></div>
    </form>
</div>
@section Scripts { <partial name="_FormDogrulama" /> }
