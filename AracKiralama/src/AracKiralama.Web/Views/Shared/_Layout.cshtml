@* SİTENİN ANA ŞABLONU: üst menü + sayfa içeriği (@RenderBody) + alt bilgi.
   Menüdeki yazılar Yönetim → Site Metinleri'nden, menüye eklenen sayfalar Yönetim → Sayfalar'dan gelir.
   Görünüm ve efektler: wwwroot/css/vitrin.css + wwwroot/js/efektler.js (yönetim paneli bunları yüklemez).
   Sayfa koyu bir bölümle başlıyorsa view'da ViewData["SaydamMenu"] = true yazılır: menü en üstte saydam olur. *@
@{
    var a = Icerik.Ayarlar;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var personelMi = User.IsInRole(Roller.Admin) || User.IsInRole(Roller.Personel);
    var saydamMenu = ViewData["SaydamMenu"] is true;
    var menuSayfalari = Icerik.Sayfalar.Where(s => s.MenudeGoster).ToList();
    var cizilenGruplar = new HashSet<string>();
    var acikSayfa = ViewContext.RouteData.Values["adres"]?.ToString();   // /Sayfa/{adres} açıksa o sayfanın adresi
    string MenuAdi(Sayfa s) => string.IsNullOrWhiteSpace(s.MenuAdi) ? s.Baslik : s.MenuAdi;
}
<!DOCTYPE html>
<html lang="tr" data-varsayilan-tema="@a.VarsayilanTema" data-vitrin>
<head>
    @* Sayfalar arası geçiş efekti (vitrin.css → "Sayfalar arası geçiş"). En başta olmalı: tarayıcı yeni sayfayı çizmeye
       başlarken bu kuralı görmezse geçişi iptal eder. Site içinden gelindiyse tema.js, ana içerik (#icerik-sonu)
       okunana kadar ilk çizimi bekletir; böylece uçan araç fotoğrafı yeni sayfada yerini bulur. *@
    <style>@@media (prefers-reduced-motion: no-preference) { @@view-transition { navigation: auto; } }</style>
    <partial name="_Head" />
    <link rel="preload" href="~/lib/archivo/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/lib/archivo/archivo.css" />
    <link rel="stylesheet" href="~/css/vitrin.css" asp-append-version="true" />
</head>
<body class="vitrin" data-imlec="@(a.OzelImlec ? "acik" : "kapali")">
    <header class="ust-menu @(saydamMenu ? "saydam-baslar" : "")">
        <div class="kaydirma-cubugu" aria-hidden="true"></div>
        <div class="kaydirma-arabasi" aria-hidden="true"><div class="kaydirma-arabasi-ray"><span class="araba-ikon"></span></div></div>
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="logo" asp-controller="AnaSayfa" asp-action="Index">
                    <span class="logo-isaret"><i class="bi @a.LogoIkonu"></i></span>
                    @a.FirmaAdi <small>@a.Slogan</small>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#menu" aria-label="Menü"><i class="bi bi-list fs-3"></i></button>

                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav mx-auto gap-lg-1 mt-3 mt-lg-0">
                        <li class="nav-item"><a class="nav-link @(controller == "AnaSayfa" && acikSayfa == null ? "active" : "")" asp-controller="AnaSayfa" asp-action="Index">@Icerik.Metin("menu.anasayfa")</a></li>
                        <li class="nav-item"><a class="nav-link @(controller == "Araclar" ? "active" : "")" asp-controller="Araclar" asp-action="Index">@Icerik.Metin("menu.araclar")</a></li>
                        @if (a.SubeleriGoster)
                        {
                            <li class="nav-item"><a class="nav-link" href="/#subeler">@Icerik.Metin("menu.subeler")</a></li>
                        }
                        @* Yönetim → Sayfalar: "Üst menüde göster" işaretli sayfalar. "Menü grubu" dolu olanlar (örn. Kurumsal)
                           tek bir açılır menüde toplanır; grup, içindeki ilk sayfanın sırasında durur. *@
                        @foreach (var sayfa in menuSayfalari)
                        {
                            var grup = sayfa.MenuGrubu?.Trim();
                            if (string.IsNullOrEmpty(grup))
                            {
                                <li class="nav-item"><a class="nav-link @(sayfa.Adres == acikSayfa ? "active" : "")" href="/Sayfa/@sayfa.Adres">@MenuAdi(sayfa)</a></li>
                            }
                            else if (cizilenGruplar.Add(grup))
                            {
                                var altSayfalar = menuSayfalari.Where(s => s.MenuGrubu?.Trim() == grup).ToList();
                                <li class="nav-item dropdown">
                                    <button class="nav-link menu-grubu @(altSayfalar.Any(s => s.Adres == acikSayfa) ? "active" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        @grup <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        @foreach (var alt in altSayfalar)
                                        {
                                            <li><a class="dropdown-item @(alt.Adres == acikSayfa ? "active" : "")" href="/Sayfa/@alt.Adres">@MenuAdi(alt)</a></li>
                                        }
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 pb-3 pb-lg-0">
                        <button class="btn btn-sade btn-ikon" type="button" data-tema-degistir aria-label="Temayı değiştir"><i class="bi bi-moon-stars"></i></button>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-sade d-flex align-items-center gap-2 py-1 ps-1 pe-3" data-bs-toggle="dropdown">
                                    <span class="avatar">@User.Identity.Name?[..1].ToUpperInvariant()</span>
                                    <span class="small">@Icerik.Metin("menu.hesabim")</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li class="px-3 py-2 small text-muted">@User.Identity.Name</li>
                                    @if (personelMi)
                                    {
                                        <li><a class="dropdown-item" asp-area="Yonetim" asp-controller="Panel" asp-action="Index"><i class="bi bi-speedometer2"></i> @Icerik.Metin("menu.yonetim")</a></li>
                                    }
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Profil" asp-action="Index"><i class="bi bi-calendar2-check"></i> @Icerik.Metin("menu.rezervasyonlarim")</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Profil" asp-action="Duzenle"><i class="bi bi-person"></i> @Icerik.Metin("menu.profil")</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-area="" asp-controller="Hesap" asp-action="Cikis" method="post">
                                            <button class="dropdown-item text-danger"><i class="bi bi-box-arrow-right text-danger"></i> @Icerik.Metin("menu.cikis")</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-sade" asp-area="" asp-controller="Hesap" asp-action="Giris">@Icerik.Metin("menu.giris")</a>
                            <a class="btn btn-primary" asp-area="" asp-controller="Hesap" asp-action="Kayit">@Icerik.Metin("menu.uyeol")</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>@RenderBody()</main>
    <span id="icerik-sonu" hidden></span>

    <partial name="_AltBilgi" />
    <partial name="_Bildirim" />

    @* jQuery burada yüklenmez (sayfalar hafif olsun); sadece form doğrulaması olan sayfalarda _FormDogrulama yükler. *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/genel.js" asp-append-version="true"></script>
    <script src="~/js/efektler.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
