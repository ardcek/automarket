    <span class="aurora aurora-2"></span>
    <span class="isik-izi" style="--y:66%; --sure:6.5s; --gecikme:-1.2s"></span>
    <span class="isik-izi ters" style="--y:74%; --sure:8s; --gecikme:-4s"></span>
    <span class="isik-izi" style="--y:84%; --sure:5.4s; --gecikme:-2.6s"></span>
    <div class="yol"><div class="yol-izgara"></div></div>
</div>
