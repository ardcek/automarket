@* ARAÇ KARTI: ana sayfa, araç listesi ve "benzer araçlar"da aynı kart kullanılır. Kartı değiştirmek = bu dosya. *@
@model AracKartiModeli
@{
    var a = Model.Arac;
    var link = Model.Filtre?.TarihDegerleri() ?? new Dictionary<string, string>();
    link["id"] = a.Id.ToString();
}
<article class="arac-karti">
    <a asp-controller="Araclar" asp-action="Detay" asp-all-route-data="link" class="gorsel">
        <img src="@(a.GorselAdresi ?? "/img/placeholder.svg")" alt="@a.TamAd" loading="lazy" />
        <span class="etiket etiket-cam">@a.Kategori?.Ad</span>
    </a>
    <div class="govde">
        <div>
            <div class="d-flex justify-content-between gap-2">
                <h3 class="baslik"><a asp-controller="Araclar" asp-action="Detay" asp-all-route-data="link" class="text-reset">@a.TamAd</a></h3>
                <span class="small text-muted">@a.Yil</span>
            </div>
            <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>@a.Sube?.Ad</div>
        </div>
        <div class="ozellikler">
            <span><i class="bi bi-gear-wide-connected"></i>@a.VitesTuru?.Ad</span>
            <span><i class="bi bi-fuel-pump"></i>@a.YakitTuru?.Ad</span>
            <span><i class="bi bi-people"></i>@a.KoltukSayisi kişi</span>
        </div>
        <div class="alt">
            <div>
                @if (Model.GunSayisi != null)
                {
                    <div class="small text-muted text-nowrap">@Model.GunSayisi gün · ≈@Bicim.Para(a.GunlukFiyat * Model.GunSayisi.Value)</div>
                }
                <div class="fiyat">@Bicim.Para(a.GunlukFiyat) <small>@Icerik.Metin("araclar.gunluk")</small></div>
            </div>
            <a asp-controller="Araclar" asp-action="Detay" asp-all-route-data="link" class="btn btn-yumusak btn-sm text-nowrap">@Icerik.Metin("araclar.incele") <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
</article>
