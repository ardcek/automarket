@* İÇERİK SAYFASI (Hakkımızda, İletişim, KVKK, SSS...). Metin Yönetim → Sayfalar'dan yazılır.
   "Soru-cevap düzeni" açık sayfada "## " satırları açılır kapanır soru olur (vitrin.css → .sss-madde).
   {tek-yon} gibi yer tutucular güncel ayarlarla doldurulur (IcerikServisi.YerTutuculariDoldur). *@
@model Sayfa
@{
    ViewData["Title"] = Model.Baslik;
    ViewData["SaydamMenu"] = true;   // sayfa koyu bantla başlıyor: üst menü en üstte saydam
    var a = Icerik.Ayarlar;
}
<section class="sayfa-sahne ust-altinda" data-sahne>
    <partial name="_SahneZemini" />
    <div class="container" style="max-width: 860px"><h1 data-giris style="--i:0">@Model.Baslik</h1></div>
</section>
<div class="container pb-4 icerik-sayfasi" style="max-width: 860px">
    @if (Model.SoruCevapDuzeni)
    {
        @* Soru-cevap düzeni (SSS): "## " satırları açılır kapanır sorular olur. İlk soru açık başlar. *@
        var (giris, sorular) = Bicim.SoruCevaplar(Icerik.YerTutuculariDoldur(Model.Icerik));
        <div class="card" data-giris style="--i:1"><div class="card-body p-4 p-md-5">
            @if (!string.IsNullOrWhiteSpace(giris)) { <div class="icerik-metni mb-3">@Bicim.Paragraflar(giris)</div> }
            <div class="sss-listesi">
                @for (var i = 0; i < sorular.Count; i++)
                {
                    <details class="sss-madde" open="@(i == 0)">
                        <summary>@sorular[i].Soru <i class="bi bi-plus-lg" aria-hidden="true"></i></summary>
                        <div class="icerik-metni">@Bicim.Paragraflar(sorular[i].Cevap)</div>
                    </details>
                }
            </div>
        </div></div>
    }
    else
    {
        <div class="card" data-giris style="--i:1"><div class="card-body p-4 p-md-5 icerik-metni">@Bicim.Paragraflar(Icerik.YerTutuculariDoldur(Model.Icerik))</div></div>
    }

    @if (Model.IletisimKartlari)
    {
        <div class="row g-3 mt-2">
            @foreach (var (ikon, baslik, deger) in new[] { ("bi-telephone", "Telefon", a.Telefon), ("bi-envelope", "E-posta", a.Eposta), ("bi-geo-alt", "Adres", a.Adres), ("bi-clock", "Çalışma saatleri", a.CalismaSaatleri) })
            {
                <div class="col-sm-6" data-goster>
                    <div class="card adim-karti text-center">
                        <span class="ikon mx-auto"><i class="bi @ikon"></i></span>
                        <div class="kucuk-baslik">@baslik</div>
                        <div class="fw-semibold">@deger</div>
                    </div>
                </div>
            }
        </div>
    }
</div>
