@* ANA SAYFA
   - Yazılar: Yönetim → Site Metinleri → "Ana sayfa" grubu
   - Bölümleri aç/kapa, görsel, öne çıkan araç sayısı: Yönetim → Ayarlar → Ana Sayfa
   - Öne çıkan araçlar: Yönetim → Araçlar → Düzenle → "Ana sayfada öne çıkar" *@
@model AnaSayfaModeli
@{
    ViewData["Title"] = Icerik.Ayarlar.Slogan;
    var a = Icerik.Ayarlar;
    string M(string anahtar) => Icerik.Metin("anasayfa." + anahtar);   // kısaltma
}

<section class="giris-alani">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="rozet-cam mb-4"><span class="nokta"></span> @M("rozet").Replace("{sube}", Model.Subeler.Count.ToString()).Replace("{arac}", Model.AracSayisi.ToString())</span>
                <h1 class="mb-4">@M("baslik") <span class="vurgu">@M("baslik-vurgu")</span> @M("baslik-son")</h1>
                <p class="lead mb-0">@M("aciklama")</p>
                @if (a.IstatistikleriGoster)
                {
                    <div class="istatistikler">
                        <div><strong>@Model.AracSayisi+</strong><span>@M("istatistik-arac")</span></div>
                        <div><strong>@Bicim.Sayi(Model.TamamlananKiralama)</strong><span>@M("istatistik-kiralama")</span></div>
                        <div><strong>@M("istatistik-ucuncu-deger")</strong><span>@M("istatistik-ucuncu")</span></div>
                    </div>
                }
            </div>
            <div class="col-lg-6 d-none d-lg-block">
                <div class="giris-gorseli">
                    <img src="@a.AnaSayfaGorseli" alt="" />
                    <div class="yuzen-kart" style="left:-28px; bottom:42px"><i class="bi bi-shield-check text-success fs-5"></i><div><b>@M("kart1-baslik")</b><div class="text-muted small">@M("kart1-metin")</div></div></div>
                    <div class="yuzen-kart" style="right:-18px; top:28px"><i class="bi bi-lightning-charge-fill text-warning fs-5"></i><div><b>@M("kart2-baslik")</b><div class="text-muted small">@M("kart2-metin")</div></div></div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container">
    <div class="arama-kutusu">
        <partial name="_AramaFormu" model="(new AracFiltresi(), Model.Subeler)" />
    </div>
</div>

@if (a.KategorileriGoster && Model.Kategoriler.Count > 0)
{
    <section class="bolum">
        <div class="container">
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
                <div>
                    <div class="bolum-ust mb-2">@M("kategoriler-ust")</div>
                    <h2 class="bolum-baslik mb-0">@M("kategoriler-baslik")</h2>
                </div>
                <a href="/Araclar" class="btn btn-sade">@M("tum-araclar") <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
            <div class="row g-3">
                @foreach (var k in Model.Kategoriler)
                {
                    <div class="col-6 col-md-4 col-xl">
                        <a class="kategori-karti" href="/Araclar?KategoriId=@k.Kategori.Id">
                            <img src="@(k.Kategori.GorselAdresi ?? "/img/placeholder.svg")" alt="@k.Kategori.Ad" loading="lazy" />
                            <div class="icerik">
                                <h3><i class="bi @k.Kategori.Ikon me-1"></i>@k.Kategori.Ad</h3>
                                <div class="small">@k.AracSayisi araç · @Bicim.Para(k.EnDusukFiyat)'den</div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

@if (a.OneCikanlariGoster && Model.OneCikanlar.Count > 0)
{
    <section class="bolum pt-0">
        <div class="container">
            <div class="bolum-ust mb-2">@M("onecikan-ust")</div>
            <h2 class="bolum-baslik mb-4">@M("onecikan-baslik")</h2>
            <div class="row g-4">
                @foreach (var arac in Model.OneCikanlar)
                {
                    <div class="col-sm-6 col-lg-3"><partial name="_AracKarti" model="new AracKartiModeli { Arac = arac }" /></div>
                }
            </div>
        </div>
    </section>
}

@if (a.NasilCalisirGoster)
{
    <section class="bolum pt-0">
        <div class="container">
            <div class="card p-3 p-md-4">
                <div class="row g-3">
                    @foreach (var (no, ikon) in new[] { (1, "bi-calendar2-range"), (2, "bi-ui-checks-grid"), (3, "bi-key") })
                    {
                        <div class="col-md-4">
                            <div class="adim-karti">
                                <span class="ikon"><i class="bi @ikon"></i></span>
                                <h3 class="h5">@M($"adim{no}-baslik")</h3>
                                <p class="text-muted mb-0">@M($"adim{no}-metin")</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}

@if (a.SubeleriGoster)
{
    <section class="bolum pt-0" id="subeler">
        <div class="container">
            <div class="bolum-ust mb-2">@M("subeler-ust")</div>
            <h2 class="bolum-baslik mb-4">@M("subeler-baslik")</h2>
            <div class="row g-3">
                @foreach (var s in Model.Subeler)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100 p-3">
                            <div class="kucuk-baslik">@s.Sehir</div>
                            <h3 class="h6 mb-1">@s.Ad</h3>
                            <div class="small text-muted mb-2">@s.Adres</div>
                            <div class="d-flex flex-wrap gap-2">
                                <span class="etiket"><i class="bi bi-telephone"></i>@s.Telefon</span>
                                <a class="etiket" href="/Araclar?AlisSubeId=@s.Id">@M("subeler-buton") <i class="bi bi-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
