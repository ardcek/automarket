// ============================================================================
// UYGULAMA AYARLARI (ASP.NET Core bu dosyayı açılışta okur)
// Bu dosyada // ile başlayan açıklama satırları kullanılabilir.
// ============================================================================
{
  "ConnectionStrings": {
    // Neon (PostgreSQL) bağlantı adresi. ŞİFRE İÇERDİĞİ İÇİN BURAYA YAZILMAZ, GitHub'a gitmez.
    //   Canlı sitede : Render → Environment → ConnectionStrings__PostgreSql
    //   Bilgisayarda : dotnet user-secrets set "ConnectionStrings:PostgreSql" "postgresql://..."
    // Boş kalırsa program Neon'a hiç bağlanmaz, sadece bilgisayardaki SQLite dosyasıyla çalışır.
    "PostgreSql": ""
  },
  "VeriTabani": {
    // Sayfalardaki veriler (araçlar, şubeler, kategoriler...) nereden okunsun?
    //   "Ornek" → örnek veriler, bilgisayardaki SQLite dosyasında (arackiralama.db). Neon'a bağlanılır,
    //             tablolar orada oluşturulur ama içine veri yazılmaz (tablolar boş kalır).
    //   "Neon"  → sayfalar doğrudan Neon'daki tablolardan okur; tablolar boşsa örnek veriler Neon'a yüklenir.
    "SayfalarNeredenOkusun": "Ornek"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
