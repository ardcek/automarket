// ============================================================================
// UYGULAMA AYARLARI (ASP.NET Core bu dosyayı açılışta okur)
// Bu dosyada // ile başlayan açıklama satırları kullanılabilir.
// ============================================================================
{
  "ConnectionStrings": {
    // Neon (PostgreSQL) bağlantı adresi. ŞİFRE İÇERDİĞİ İÇİN BURAYA YAZILMAZ, GitHub'a gitmez.
    //   Canlı sitede : Render → Environment → ConnectionStrings__PostgreSql
    //   Bilgisayarda : dotnet user-secrets set "ConnectionStrings:PostgreSql" "postgresql://..."
    // Boş kalırsa program Neon'a hiç bağlanmaz, sadece bilgisayardaki SQLite dosyasıyla çalışır.
    "PostgreSql": ""
  },
  "VeriTabani": {
    // Sayfalardaki veriler (araçlar, şubeler, kategoriler...) nereden okunsun?
    //   "Ornek" → örnek veriler, bilgisayardaki SQLite dosyasında (arackiralama.db). Neon'a bağlanılır,
    //             tablolar orada oluşturulur ama içine veri yazılmaz (tablolar boş kalır).
    //   "Neon"  → sayfalar doğrudan Neon'daki tablolardan okur; tablolar boşsa örnek veriler Neon'a yüklenir.
    "SayfalarNeredenOkusun": "Ornek"
  },
  "YapayZeka": {
    // Yönetim → Yapay Zekâ Asistanı. İnternetsiz çalışır; sadece bilgisayarda kullanılır
    // (Render'da motor dosyaları olmadığı için sayfa "kurulu değil" der). Kurulum: AracKiralama/yapay-zeka/BENI-OKU.md
    //
    // Motorun (llama-server.exe) ve model dosyalarının (.gguf) bulunduğu klasör. Uygulama klasörüne göredir:
    // src/AracKiralama.Web → ../../yapay-zeka = AracKiralama/yapay-zeka
    "Klasor": "../../yapay-zeka",
    // Hazır çalışan bir yapay zekâ sunucusu kullanılacaksa adresi (Ollama: http://127.0.0.1:11434, LM Studio: http://127.0.0.1:1234).
    // Boşsa uygulama kendi motorunu açar.
    "Adres": "",
    // Model dosyasının adı (yapay-zeka/modeller içinde). Boşsa: RAM 16 GB ve üzeriyse büyük model, değilse küçük model.
    "Model": "",
    // Motorun dinleyeceği port (sadece bu bilgisayardan erişilebilir).
    "Port": 8089,
    // Modelin aynı anda okuyabileceği metin uzunluğu (token). Bellek yetmezse motor kendiliğinden küçültür.
    "BaglamUzunlugu": 16384,
    // llama-server'a eklenecek parametreler. --reasoning-budget 0 → "düşünen" modellerde düşünme bölümünü kapatır (daha hızlı).
    "EkParametreler": "--reasoning-budget 0"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
