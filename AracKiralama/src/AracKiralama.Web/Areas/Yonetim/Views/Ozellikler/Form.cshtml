@* YENİ / DÜZENLE: ARAÇ ÖZELLİĞİ (OzelliklerController.Ekle / Duzenle, model: OzellikFormu) *@
@model OzellikFormu
@{
    var duzenleme = Model.Id != null;
    ViewData["Title"] = duzenleme ? "Özelliği düzenle" : "Yeni özellik / filtre";
}
<div class="sayfa-baslik"><div><a asp-action="Index" class="small"><i class="bi bi-arrow-left me-1"></i>Filtreler ve Özellikler</a><h1 class="mt-1">@ViewData["Title"]</h1></div></div>

<form asp-action="@(duzenleme ? "Duzenle" : "Ekle")" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
    <div class="row g-3">
        <div class="col-xl-8">
            <div class="card"><div class="card-body row g-3">
                <div class="col-md-6"><label asp-for="Ad" class="form-label"></label><input asp-for="Ad" class="form-control" placeholder="örn. Bagaj hacmi, Klima, Renk" /><span asp-validation-for="Ad"></span></div>
                <div class="col-md-6">
                    <label asp-for="Tur" class="form-label"></label>
                    <select asp-for="Tur" class="form-select" asp-items="Html.GetEnumSelectList<OzellikTuru>()"></select>
                    <div class="form-text">Seçim listesi → açılır liste · Sayı → en az / en çok · Var / Yok → evet mi hayır mı · Serbest yazı → içinde arama</div>
                </div>
                @* Türüne göre gerekli olan alanlar *@
                <div class="col-md-6">
                    <label asp-for="SeceneklerMetni" class="form-label"></label>
                    <textarea asp-for="SeceneklerMetni" class="form-control" rows="5" placeholder="Beyaz&#10;Siyah&#10;Kırmızı"></textarea>
                    <div class="form-text">Sadece "Seçim listesi" türünde kullanılır.</div>
                    <span asp-validation-for="SeceneklerMetni"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Birim" class="form-label"></label>
                    <input asp-for="Birim" class="form-control" placeholder="lt" />
                    <div class="form-text">Sadece "Sayı" türünde kullanılır. Filtrede ve kartta sayının yanına yazılır.</div>
                    <label asp-for="Ikon" class="form-label mt-3"></label>
                    <div class="input-group">
                        <span class="input-group-text"><i id="ikon-onizleme" class="bi @Model.Ikon"></i></span>
                        <input asp-for="Ikon" class="form-control" data-ikon-onizle="#ikon-onizleme" />
                    </div>
                    <div class="form-text">Bootstrap ikon adı: bi-suitcase, bi-snow, bi-palette, bi-lightning…</div>
                </div>
            </div></div>
        </div>
        <div class="col-xl-4">
            <div class="card"><div class="card-header">Nerede görünsün?</div><div class="card-body d-grid gap-2">
                <div class="form-check form-switch"><input asp-for="FiltredeGoster" class="form-check-input" role="switch" /><label asp-for="FiltredeGoster" class="form-check-label"></label></div>
                <div class="form-check form-switch"><input asp-for="KarttaGoster" class="form-check-input" role="switch" /><label asp-for="KarttaGoster" class="form-check-label"></label></div>
                <div class="form-check form-switch"><input asp-for="DetaydaGoster" class="form-check-input" role="switch" /><label asp-for="DetaydaGoster" class="form-check-label"></label></div>
                <div class="form-check form-switch"><input asp-for="Aktif" class="form-check-input" role="switch" /><label asp-for="Aktif" class="form-check-label"></label></div>
            </div></div>
            <div class="card mt-3"><div class="card-body"><label asp-for="Sira" class="form-label"></label><input asp-for="Sira" class="form-control" /></div></div>
            <button class="btn btn-primary btn-lg w-100 mt-3"><i class="bi bi-check2 me-1"></i>Kaydet</button>
        </div>
    </div>
</form>
@section Scripts { <partial name="_FormDogrulama" /> }
