@* FİLTRELER VE ÖZELLİKLER (OzelliklerController.Index, model: List<AracOzelligi>)
   Üstte hazır filtrelerin aç/kapa düğmeleri, altta panelden eklenen özellikler.
   Yeni özellik: araç listesinde filtre, kartta ve detayda bilgi olarak görünür. *@
@model List<AracOzelligi>
@{
    ViewData["Title"] = "Filtreler ve Özellikler";
    var hazirlar = (List<DuzenleyiciAlani>)ViewBag.HazirFiltreler;
    var degerSayilari = (Dictionary<int, int>)ViewBag.DegerSayilari;
    var aracSayisi = (int)ViewBag.AracSayisi;
}
<div class="sayfa-baslik">
    <div><h1><i class="bi bi-funnel me-2 metin-ana"></i>Filtreler ve Özellikler</h1><div class="alt-yazi">Araç listesindeki filtreleri aç / kapa, araçlara yeni bir bilgi ekle.</div></div>
    <div class="d-flex gap-2">
        <a href="/Araclar" target="_blank" class="btn btn-sade"><i class="bi bi-box-arrow-up-right me-1"></i>Araç listesini aç</a>
        <a asp-action="Ekle" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Yeni özellik / filtre</a>
    </div>
</div>

@* Nasıl kullanılır: hoca "X filtresi ekleyin" derse *@
<div class="alert alert-primary d-flex gap-3 align-items-start">
    <i class="bi bi-lightbulb fs-4"></i>
    <div class="small">
        <b>Örnek: "Araçlara bagaj hacmi ekleyin, ona göre filtrelensin."</b>
        <ol class="mb-0 mt-1 ps-3">
            <li><b>Yeni özellik / filtre</b>'ye bas. Ad: <i>Bagaj hacmi</i>, Tür: <i>Sayı</i>, Birim: <i>lt</i> → Kaydet.</li>
            <li>Açılan tabloda her aracın bagaj hacmini yaz → Kaydet.</li>
            <li>Araç listesini aç: solda "Bagaj hacmi (lt)" filtresi çıktı. Kartta da görünsün istersen özelliği düzenleyip "Araç kartında göster"i işaretle.</li>
        </ol>
        <div class="mt-1 text-muted">Seçim listesi (örn. Renk: Beyaz / Siyah), Var / Yok (örn. Klima) ve serbest yazı türleri de var.</div>
    </div>
</div>

<div class="row g-3">
    @* ---------------- Panelden eklenen özellikler ---------------- *@
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header">Senin eklediğin özellikler</div>
            @if (Model.Count == 0)
            {
                <div class="card-body text-muted">Henüz özellik eklenmedi. <a asp-action="Ekle">İlk özelliği ekle</a>.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>Özellik</th><th>Türü</th><th>Nerede görünür</th><th>Dolu araç</th><th class="text-end"></th></tr></thead>
                        <tbody>
                            @foreach (var o in Model)
                            {
                                <tr class="@(o.Aktif ? "" : "opacity-50")">
                                    <td><i class="bi @o.Ikon me-2 metin-ana"></i><b>@o.Ad</b>@(o.Birim != null ? $" ({o.Birim})" : "")
                                        @if (o.Tur == OzellikTuru.Secim) { <div class="small text-muted text-truncate" style="max-width:260px">@string.Join(" · ", o.SecenekListesi)</div> }</td>
                                    <td class="small">@o.Tur.Ad()</td>
                                    <td class="small">
                                        @if (!o.Aktif) { <span class="durum durum-reddedildi">Yayında değil</span> }
                                        @if (o.FiltredeGoster) { <span class="etiket">Filtre</span> }
                                        @if (o.KarttaGoster) { <span class="etiket">Kart</span> }
                                        @if (o.DetaydaGoster) { <span class="etiket">Detay</span> }
                                    </td>
                                    <td class="small">@degerSayilari.GetValueOrDefault(o.Id) / @aracSayisi</td>
                                    <td class="text-end text-nowrap">
                                        <a asp-action="Degerler" asp-route-id="@o.Id" class="btn btn-sm btn-primary"><i class="bi bi-table me-1"></i>Değerleri gir</a>
                                        <a asp-action="Duzenle" asp-route-id="@o.Id" class="btn btn-sm btn-sade">Düzenle</a>
                                        <form asp-action="Sil" asp-route-id="@o.Id" method="post" class="d-inline"><button class="btn btn-sm btn-sade text-danger" data-onay="&quot;@o.Ad&quot; ve bütün araçlardaki değerleri silinsin mi?">Sil</button></form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ---------------- Hazır filtreler: aç / kapa ---------------- *@
    <div class="col-xl-4">
        <form asp-action="HazirFiltreler" method="post" class="card">
            <div class="card-header">Hazır filtreler</div>
            <div class="card-body d-grid gap-2">
                @foreach (var alan in hazirlar)
                {
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" id="h-@alan.Anahtar" name="@alan.FormAdi" value="true" checked="@(alan.Deger == "true")" />
                        <input type="hidden" name="@alan.FormAdi" value="false" />
                        <label class="form-check-label" for="h-@alan.Anahtar">@alan.Etiket</label>
                    </div>
                }
                <button class="btn btn-primary mt-2"><i class="bi bi-check2 me-1"></i>Kaydet</button>
                <div class="small text-muted">Kapattığın filtre araç listesinden kalkar. Yazılarını değiştirmek için: Site Düzenleyici → Araç listesi.</div>
            </div>
        </form>
    </div>
</div>
