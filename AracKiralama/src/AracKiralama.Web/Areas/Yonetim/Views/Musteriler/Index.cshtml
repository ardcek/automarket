@* MÜŞTERİLER VE KULLANICILAR: bütün hesaplar (müşteri + personel), harcamaya göre sıralı.
   Kişiye tıklayınca detay: geçmiş, ödemeler, hasarlar, hesap işlemleri (Musteriler/Detay.cshtml). *@
@model List<MusteriSatiri>
@{
    ViewData["Title"] = "Müşteriler ve Kullanıcılar";
    var seciliRol = ViewBag.Rol as string;
}
<div class="sayfa-baslik">
    <div><h1>Müşteriler ve Kullanıcılar</h1><div class="alt-yazi">@Model.Count kişi · ada tıklayınca bütün geçmişi açılır</div></div>
    @if (User.IsInRole(Roller.Admin)) { <a href="/Yonetim/Personel/Ekle" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Yeni kullanıcı</a> }
</div>
<div class="card tablo-karti">
    <form method="get" class="card-header d-flex flex-wrap gap-2 align-items-center" data-otomatik-gonder>
        <div class="input-group" style="max-width:340px"><span class="input-group-text"><i class="bi bi-search"></i></span><input type="search" name="arama" value="@ViewBag.Arama" class="form-control" placeholder="Ad, e-posta veya telefon" /></div>
        <select name="rol" class="form-select" style="width:auto" aria-label="Rol">
            <option value="">Herkes</option>
            @foreach (var r in (User.IsInRole(Roller.Admin) ? new[] { Roller.Musteri, Roller.Personel, Roller.Admin, Roller.SuperAdmin } : new[] { Roller.Musteri, Roller.Personel, Roller.Admin }))
            {
                <option value="@r" selected="@(r == seciliRol)">@(r == Roller.Musteri ? "Müşteriler" : Roller.Ad(r))</option>
            }
        </select>
        <div class="form-check form-switch ms-2"><input class="form-check-input" type="checkbox" id="kl" name="karaListe" value="true" checked="@((bool)ViewBag.KaraListe)" /><label class="form-check-label small" for="kl">Sadece kara liste</label></div>
        <button class="btn btn-sade">Ara</button>
    </form>
    <div class="table-responsive"><table class="table table-hover align-middle">
        <thead><tr><th>Kişi</th><th>Rol</th><th>Telefon</th><th class="text-end">Kiralama</th><th class="text-end">Harcama</th><th></th></tr></thead>
        <tbody>
            @foreach (var s in Model)
            {
                var k = s.Kullanici;
                <tr>
                    <td>
                        <a href="/Yonetim/Musteriler/Detay/@k.Id" class="fw-semibold text-reset">@k.TamAd</a>
                        @if (k.KaraListede) { <span class="durum durum-reddedildi">Kara liste</span> }
                        @if (k.LockoutEnd > DateTimeOffset.Now) { <span class="durum durum-reddedildi">Dondurulmuş</span> }
                        <div class="small text-muted">@k.Email</div>
                    </td>
                    <td><span class="durum @(s.Rol == Roller.Musteri ? "durum-pasif" : s.Rol == Roller.SuperAdmin ? "durum-tamamlandi" : "durum-onaylandi")">@(s.Rol == Roller.Musteri ? "Müşteri" : Roller.Ad(s.Rol))</span></td>
                    <td class="small">@(k.PhoneNumber ?? "-")</td>
                    <td class="text-end rakam">@s.KiralamaSayisi</td>
                    <td class="text-end rakam fw-semibold">@Bicim.Para(s.ToplamHarcama)</td>
                    <td class="text-end"><a href="/Yonetim/Musteriler/Detay/@k.Id" class="btn btn-sm btn-sade" aria-label="Detay"><i class="bi bi-chevron-right"></i></a></td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="6" class="bos-durum">Aramaya uyan kişi yok.</td></tr> }
        </tbody>
    </table></div>
</div>
