@* PERSONEL VE ROLLER (Admin ve Süper Admin görür). İşlemler: Areas/Yonetim/Controllers/KullaniciControllerlari.cs → PersonelController
   Süper Admin: Süper Admin / Admin / Personel verebilir. Admin: sadece Admin / Personel; Süper Admin satırları ona kilitli.
   Kimin neyi verebileceği tek yerde: Yardimcilar/Genel.cs → Roller.Verebilecegi *@
@model List<(Kullanici Kullanici, string Rol)>
@using System.Security.Claims
@{
    ViewData["Title"] = "Personel";
    var benimId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var superMi = User.IsInRole(Roller.SuperAdmin);
    var verebilecegim = Roller.Verebilecegi(User);
}
<div class="sayfa-baslik">
    <div><h1>Personel ve Roller</h1><div class="alt-yazi">Süper Admin: her şey + site düzenleme. Admin: operasyon, kayıtlar ve bu sayfa. Personel: bu sayfa hariç Admin'in gördükleri.</div></div>
    <a href="/Yonetim/Personel/Ekle" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Yeni kullanıcı</a>
</div>

@* Sitede üye olmuş birine yetki vermek *@
<div class="card mb-4"><div class="card-body">
    <h2 class="h6 mb-1"><i class="bi bi-person-check me-1"></i>Üye olmuş birine yetki ver</h2>
    <p class="small text-muted mb-3">
        Kişi önce sitede kendi e-postası ve şifresiyle üye olur; siz burada e-postasını yazarsınız. Yetki, kişi bir kez çıkış yapıp tekrar girince görünür.
        @(superMi ? "Süper Admin olarak üç yetkiyi de verebilirsiniz." : "Admin olarak Admin ya da Personel yetkisi verebilirsiniz.")
    </p>
    <form asp-action="YetkiVer" method="post" class="row g-2 align-items-end">
        <div class="col-md-6"><label for="eposta" class="form-label">E-posta</label><input id="eposta" name="eposta" type="email" class="form-control" required autocomplete="off" placeholder="ornek@eposta.com" /></div>
        <div class="col-md-3"><label for="rol" class="form-label">Yetki</label>
            <select id="rol" name="rol" class="form-select">
                @foreach (var rol in verebilecegim) { <option value="@rol" selected="@(rol == Roller.Admin)">@Roller.Ad(rol)</option> }
            </select>
        </div>
        <div class="col-md-3"><button class="btn btn-primary w-100" data-onay="Bu kişiye yetki verilsin mi?">Yetki ver</button></div>
    </form>
</div></div>

<div class="card tablo-karti"><div class="table-responsive"><table class="table align-middle">
    <thead><tr><th>Ad Soyad</th><th>E-posta</th><th>Rol</th><th></th></tr></thead>
    <tbody>
        @foreach (var (k, rol) in Model)
        {
            <tr>
                <td class="fw-semibold"><a href="/Yonetim/Musteriler/Detay/@k.Id" class="text-reset">@k.TamAd</a></td><td>@k.Email</td>
                <td><span class="durum @(rol == Roller.SuperAdmin ? "durum-tamamlandi" : rol == Roller.Admin ? "durum-onaylandi" : "durum-kirada")">@Roller.Ad(rol)</span></td>
                <td class="text-end">
                    @if (k.Id == benimId)
                    {
                        <span class="small text-muted">Siz</span>
                    }
                    else if (rol == Roller.SuperAdmin && !superMi)
                    {
                        <span class="small text-muted"><i class="bi bi-lock me-1"></i>Sadece Süper Admin değiştirebilir</span>
                    }
                    else
                    {
                        <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                            <form asp-action="RolDegistir" asp-route-id="@k.Id" method="post" class="d-inline-flex gap-1">
                                <select name="rol" class="form-select form-select-sm" aria-label="@k.TamAd için yeni yetki" style="width:auto">
                                    @foreach (var secenek in verebilecegim) { <option value="@secenek" selected="@(secenek == rol)">@Roller.Ad(secenek)</option> }
                                </select>
                                <button class="btn btn-sm btn-sade" data-onay="Yetki değiştirilsin mi?">Değiştir</button>
                            </form>
                            <form asp-action="YetkiAl" asp-route-id="@k.Id" method="post"><button class="btn btn-sm btn-sade text-danger" data-onay="Yetkisi alınsın mı? Kişi panele giremez, normal müşteri olur.">Yetkiyi al</button></form>
                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table></div></div>
